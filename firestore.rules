rules_version = '2';

// Regras do Cloud Firestore — Terra Fibra.
// Publique em: Console do Firebase > Firestore > Regras > Publicar.
//
// Modelo: cada usuário só lê/grava o PRÓPRIO documento users/{uid}.
//  - Cadastro (js/auth.js): cria users/{uid} com displayName, phoneNumber, email, createdAt.
//  - Último cálculo (js/ultimo-calculo-db.js): atualiza SOMENTE o campo `lastCalculation`.
//  - Nenhum usuário lê ou altera dados de outro usuário. Exclusão só pelo backend.
// ATENÇÃO: o painel admin atual (admin.html/admin.js) usa credenciais no front e acessa a
// coleção inteira sem login no Firebase; ele NÃO funciona com estas regras (de propósito).
service cloud.firestore {
  match /databases/{database}/documents {

    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function numeroOk(v) {
      return v is number && v >= 0 && v <= 1000000000;
    }

    function calculoValido(c) {
      return c is map
        && c.keys().hasOnly(['category', 'categoryLabel', 'inputs', 'baseCommission', 'qualityAccelerator',
                             'components', 'finalAmount', 'pctAttainment', 'partial', 'memory', 'warnings',
                             'rulesVersion', 'calculatedAt'])
        && c.keys().hasAll(['category', 'categoryLabel', 'inputs', 'baseCommission', 'components',
                            'finalAmount', 'partial', 'memory', 'warnings', 'rulesVersion', 'calculatedAt'])
        && c.category in ['consultor_pap', 'consultor_callcenter', 'consultor_digital', 'vendedor_loja',
                          'lider_pap', 'lider_callcenter', 'lider_digital_time', 'lider_digital_proprias',
                          'coordenador_callcenter', 'executivo_vendas', 'gerente_regional', 'casa_conectada']
        && c.categoryLabel is string && c.categoryLabel.size() <= 100
        && c.inputs is map && c.inputs.size() <= 10
        && numeroOk(c.baseCommission)
        && numeroOk(c.finalAmount)
        && (!('qualityAccelerator' in c) || numeroOk(c.qualityAccelerator))
        && (!('pctAttainment' in c) || numeroOk(c.pctAttainment))
        && c.components is list && c.components.size() <= 10
        && c.partial is bool
        && c.memory is list && c.memory.size() <= 20
        && c.warnings is list && c.warnings.size() <= 10
        && c.rulesVersion is string && c.rulesVersion.size() <= 30
        && c.calculatedAt == request.time;
    }

    match /users/{uid} {
      allow read: if dono(uid);

      allow create: if dono(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'phoneNumber', 'email', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 2
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.phoneNumber is string
        && request.resource.data.phoneNumber.size() <= 20
        && request.resource.data.email is string
        && request.resource.data.email.matches('^[0-9]+@phone\\.invalid$');

      // Só o campo lastCalculation pode mudar; nome, telefone e demais campos ficam intocados.
      allow update: if dono(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastCalculation'])
        && calculoValido(request.resource.data.lastCalculation);

      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
